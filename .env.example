# ─────────────────────────────────────────────────────────────
# Neko Neko — biến môi trường (xem sheet 18 trong file Excel đặc tả)
# Sao chép file này thành .env.local rồi điền giá trị.
# KHÔNG commit .env.local lên Git.
# ─────────────────────────────────────────────────────────────

# Để TRỐNG hai biến dưới đây → app chạy ở CHẾ ĐỘ DEMO
# (không cần Supabase, dữ liệu học lấy từ content/seed, trạng thái trí nhớ lưu tạm trong bộ nhớ máy chủ).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# BÍ MẬT — chỉ dùng ở server (Route Handler, script seed). Không bao giờ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# development | preview | production — hiện nhãn môi trường khi không phải production
NEXT_PUBLIC_APP_ENV=development

# Tuỳ chọn, chưa dùng ở MVP (AI Engine — sheet 15)
AI_PROVIDER_API_KEY=
