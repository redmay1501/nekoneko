{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NekoNeko exercises",
  "type": "object",
  "required": ["version", "grammar_lessons", "exercises"],
  "properties": {
    "version": { "type": "string" },
    "created": { "type": "string" },
    "note": { "type": "string" },
    "grammar_lessons": {
      "type": "array",
      "items": { "type": "object", "required": ["lesson", "title_vi"],
        "properties": { "lesson": { "type": "integer", "minimum": 1, "maximum": 25 }, "title_vi": { "type": "string" } } }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "grammar_lesson", "type", "type_vi", "pattern_ids", "patterns", "instruction_vi"],
        "properties": {
          "id": { "type": "string", "pattern": "^L[0-9]{2}-[STQD][0-9]+$" },
          "grammar_lesson": { "type": "integer", "minimum": 1, "maximum": 25 },
          "type": { "enum": ["substitution", "transformation", "qa", "dialogue"] },
          "type_vi": { "type": "string" },
          "pattern_ids": { "type": "array", "items": { "type": "string", "pattern": "^g[0-9]{3}$" } },
          "patterns": { "type": "array", "items": { "type": "string" } },
          "instruction_vi": { "type": "string" },
          "frame": { "type": "string", "description": "Chỉ có ở substitution" },
          "answer_mode": { "enum": ["exact", "model"], "description": "exact: chấm khớp; model: đáp án mẫu" },
          "items": {
            "type": "array",
            "items": { "type": "object", "required": ["n", "is_example", "prompt", "answers", "readings"],
              "properties": {
                "n": { "type": "integer" }, "is_example": { "type": "boolean" }, "prompt": { "type": "string" },
                "cue_vi": { "type": ["string", "null"] },
                "answers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "readings": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
          },
          "title_vi": { "type": "string", "description": "Chỉ có ở dialogue" },
          "lines": {
            "type": "array",
            "items": { "type": "object", "required": ["speaker", "text", "text_full", "vi", "reading"],
              "properties": { "speaker": { "type": "string" }, "text": { "type": "string", "description": "Có {{n}} tại chỗ trống" },
                "text_full": { "type": "string" }, "vi": { "type": "string" }, "reading": { "type": "string" } } }
          },
          "blanks": {
            "type": "array",
            "items": { "type": "object", "required": ["n", "options", "answer_index", "answers"],
              "properties": { "n": { "type": "integer" }, "options": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } },
                "answer_index": { "type": "integer", "minimum": 1, "maximum": 4 }, "answers": { "type": "array", "items": { "type": "string" } } } }
          },
          "script_for_listening": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "dialogue" } } }, "then": { "required": ["title_vi", "lines", "blanks"] },
            "else": { "required": ["items", "answer_mode"] } }
        ]
      }
    }
  }
}
